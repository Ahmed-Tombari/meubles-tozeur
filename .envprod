APP_NAME="Meubles Tozeur"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_YOUR_KEY
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_YOUR_DOMAIN

LOG_CHANNEL=stack
LOG_LEVEL=error

# DATABASE (Railway MySQL or PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=REPLACE_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_DB_NAME
DB_USERNAME=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD

# CACHE / SESSION
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# FILESYSTEM
FILESYSTEM_DISK=public

# MAIL (optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@meubles-tozeur.com"
MAIL_FROM_NAME="${APP_NAME}"